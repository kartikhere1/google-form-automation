# ============================================================
# .gitignore — Google Form Automation Project
# Prevents sensitive files and OS/editor noise from being
# tracked by Git.
# ============================================================


# ─── Node.js ────────────────────────────────────────────────
# Installed packages — never commit these; run `npm install` instead
node_modules/

# npm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lock files (optional — remove these lines if you want to track them)
# package-lock.json
# yarn.lock


# ─── clasp (Google Apps Script CLI) ─────────────────────────
# clasp authentication token — SENSITIVE! Contains your Google credentials.
# Never commit this file.
.clasprc.json

# clasp project config — contains your Script ID.
# You may choose to commit or ignore this depending on your team setup.
# Uncomment the line below to ignore it:
# .clasp.json


# ─── Environment & Secrets ───────────────────────────────────
# Environment variable files — may contain API keys or passwords
.env
.env.local
.env.production
.env.*

# Google service account keys — highly sensitive
*.json.key
credentials.json
token.json


# ─── Operating System Files ──────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~


# ─── VS Code ─────────────────────────────────────────────────
# VS Code workspace settings (keep or ignore based on preference)
# .vscode/

# Common VS Code files to ignore
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
.vscode/*.code-snippets
.vscode/extensions.json


# ─── Logs & Temporary Files ──────────────────────────────────
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo


# ─── Build Artifacts ─────────────────────────────────────────
dist/
build/
out/
